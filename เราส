			if not c then return end
			for _, p in pairs(c:GetChildren()) do
				local n = p.Name:lower()
				if p:IsA("BasePart") and (n == "leftleg" or n == "left leg" or n:find("leftlowerleg") or n:find("leftfoot") or n:find("leftupperleg")) then
