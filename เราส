	NX.Threads = {}
	for _, d in ipairs(NX.Drawings) do pcall(function() d:Remove() end) end
	NX.Drawings = {}
	for _, inst in ipairs(NX.Spawned) do pcall(function() inst:Destroy() end) end
	NX.Spawned = {}
	pcall(function()
