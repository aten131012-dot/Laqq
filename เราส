LogoButton.Parent = Gui
Corner(LogoButton, 50)
Stroke(LogoButton, RED, 2)

local function OpenGUI()
	Main.Visible = true
	Main.Position = UDim2.new(0.5, 0, 0.5, 0)
	TweenService:Create(Main, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.new(0, 680, 0, 490) }):Play()
end
local function CloseGUI()
	Main.Visible = false
end

LogoButton.MouseButton1Click:Connect(function()
	if Main.Visible then CloseGUI() else OpenGUI() end
end)

Min.MouseButton1Click:Connect(CloseGUI)
Close.MouseButton1Click:Connect(function() Gui:Destroy() end)

task.spawn(NX.SendWebhook)

