		e.line.BorderSizePixel = 0
		e.line.Visible = false
		e.line.Parent = sg
		entries[m] = e
		return e
	end
	local function hide(e)
		e.name.Visible = false; e.dist.Visible = false; e.box.Visible = false
		e.hpBG.Visible = false; e.line.Visible = false
	end

	local function update()
		if sg.Parent ~= PlayerGui then sg.Parent = PlayerGui end
		local cam = workspace.CurrentCamera
		if not cam then return end
		local seen = {}
		if ESP.Name or ESP.Dist or ESP.Box or ESP.Tracer then
			local vp = cam.ViewportSize
			local mr = GetHRP(GetChar())
			local myPos = mr and mr.Position or cam.CFrame.Position
			for _, i in ipairs(NX.T.alive()) do
				local rp = i.root.Position
				local c = cam:WorldToViewportPoint(rp)
				if c.Z > 0 then
					seen[i.model] = true
					local e = entries[i.model] or newEntry(i.model)
					local topOff = (i.head ~= i.root) and (i.head.Size.Y / 2 + 0.3) or 3
					local top = cam:WorldToViewportPoint(i.head.Position + Vector3.new(0, topOff, 0))
					local bot = cam:WorldToViewportPoint(rp - Vector3.new(0, 3, 0))
					local h = math.max(bot.Y - top.Y, 8)
					local w = h * 0.55
					local cx = c.X

					e.name.Visible = ESP.Name
					if ESP.Name then
						e.name.Text = i.name
						e.name.Position = UDim2.fromOffset(cx, top.Y - 9)
					end
					e.dist.Visible = ESP.Dist
					if ESP.Dist then
						e.dist.Text = "[" .. math.floor((rp - myPos).Magnitude + 0.5) .. " studs]"
						e.dist.Position = UDim2.fromOffset(cx, bot.Y + 9)
					end
					e.box.Visible = ESP.Box
					e.hpBG.Visible = ESP.Box
					if ESP.Box then
						e.box.Position = UDim2.fromOffset(cx - w / 2, top.Y)
						e.box.Size = UDim2.fromOffset(w, h)
						e.hpBG.Position = UDim2.fromOffset(cx - w / 2 - 6, top.Y)
						e.hpBG.Size = UDim2.fromOffset(3, h)
						local ratio = 1
						if i.hum and i.hum.MaxHealth > 0 then ratio = math.clamp(i.hum.Health / i.hum.MaxHealth, 0, 1) end
						e.hpFill.Size = UDim2.new(1, 0, ratio, 0)
					end
					e.line.Visible = ESP.Tracer
					if ESP.Tracer then
						local sx, sy = vp.X / 2, 0
						local dx, dy = cx - sx, c.Y - sy
						e.line.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), 1.5)
						e.line.Position = UDim2.fromOffset((sx + cx) / 2, (sy + c.Y) / 2)
						e.line.Rotation = math.deg(math.atan2(dy, dx))
					end
				end
			end
		end
		for m, e in pairs(entries) do
			if not seen[m] then
				hide(e)
				if not m.Parent then
					for _, v in pairs(e) do pcall(function() v:Destroy() end) end
					entries[m] = nil
				end
			end
		end
	end
	table.insert(NX.Conns, RunService.RenderStepped:Connect(function() pcall(update) end))

