					lbl.Text = "[BOT] " .. i.model.Name
					lbl.TextColor3 = RED
					lbl.TextSize = 13
					lbl.Font = Enum.Font.GothamBold
					lbl.TextStrokeTransparency = 0.4
					lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
					lbl.Parent = bb
					npc[i.model] = { hl = hl, bb = bb }
				end
			end
		end
		for m, d in pairs(npc) do
			if not alive[m] then
