		local function startFC()
			local cam = workspace.CurrentCamera
			if not cam then return end
			FC.on = true
			FC.pos = cam.CFrame.Position
			local rx, ry = cam.CFrame:ToOrientation()
			FC.pitch, FC.yaw = rx, ry
			local r = GetHRP(GetChar())
			if r then FC.anch = r.Anchored; r.Anchored = true end
			FC.inp = UserInputService.InputChanged:Connect(function(i, gp)
				if not FC.on then return end
				local mouseLook = i.UserInputType == Enum.UserInputType.MouseMovement and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
				local touchLook = i.UserInputType == Enum.UserInputType.Touch and not gp
				if mouseLook or touchLook then
					FC.yaw -= i.Delta.X * 0.005
					FC.pitch = math.clamp(FC.pitch - i.Delta.Y * 0.005, -1.5, 1.5)
				end
			end)
			FC.conn = RunService.RenderStepped:Connect(function(dt)
				local c, hm = workspace.CurrentCamera, GetHum(GetChar())
				if not c then return end
				c.CameraType = Enum.CameraType.Scriptable
				local cf = CFrame.new(FC.pos) * CFrame.Angles(0, FC.yaw, 0) * CFrame.Angles(FC.pitch, 0, 0)
				local dir = Vector3.zero
